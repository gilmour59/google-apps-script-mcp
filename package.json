{
  "name": "google-apps-script-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for managing Google Apps Script projects via the official Apps Script API",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "auth": "tsx src/auth-cli.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "googleapis": "182.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  }
}
